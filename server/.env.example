# ---- Core ----
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codesprint?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# ---- Frontend / CORS / cookies ----
# Comma-separated list of allowed browser origins (your Netlify URL in production).
CLIENT_URL=http://localhost:5173
# Set true ONLY if the browser calls this API on a different site than the frontend (SameSite=None; Secure).
# Keep false when using the Netlify API proxy (first-party cookies).
CROSS_SITE_COOKIES=false

# ---- Platform ----
PLATFORM_TIMEZONE=Asia/Kolkata

# ---- Cloudinary (video storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=codesprint/solutions
VIDEO_MAX_SIZE_MB=500
VIDEO_ALLOWED_FORMATS=mp4,mov,webm,mkv

# ---- First admin account (created on first start if the email does not exist) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Password-reset email (optional; without SMTP the reset link is logged in development) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CodeSprint <no-reply@yourdomain.com>
